# Copiar a .env y completar con valores reales. Nunca commitear .env con datos reales.

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=netcontact

# Autenticación
JWT_SECRET=
ADMIN_PASSWORD=

# Servidor
PORT=3000
FRONTEND_URL=http://localhost:5173

# Google Sheets — copia operativa de Postulantes (Reclutamiento).
# Opcional: si se dejan vacías, el sistema sigue funcionando normalmente
# y solo se omite la sincronización a Sheets (MySQL sigue siendo la fuente real).
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
